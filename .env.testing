# =============================================================================
# ACMS — ملف بيئة الاختبار
# =============================================================================
# التطوير اليومي:  .env  →  clinic_management_system_3
# الاختبارات:      phpunit.xml / هذا الملف  →  acms_testing
# ⚠️ لا تنسخ هذا الملف فوق .env المحلي
# =============================================================================

APP_NAME="ACMS Testing"
APP_ENV=testing
APP_KEY=base64:NT68UDl1nfjXaQh+X2y73e1kI2aHiLsUom2UpfSq0dY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acms_testing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array
MAIL_FROM_ADDRESS="testing@acms.test"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=acms-testing-jwt-secret-key-for-ci-only

STRIPE_KEY=sk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder

TELESCOPE_ENABLED=false
PULSE_ENABLED=false

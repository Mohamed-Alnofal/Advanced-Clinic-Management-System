{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "agence104/livekit-server-sdk": "^1.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "carlos-meneses/laravel-mpdf": "*",
        "google/apiclient": "*",
        "guzzlehttp/guzzle": "^7.2",
        "khaled.alshamaa/ar-php": "*",
        "kreait/firebase-php": "^5.26",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "minishlink/web-push": "^10.1",
        "mpdf/mpdf": "8.2",
        "nwidart/laravel-modules": "11.0",
        "orchestra/parser": "^8.0",
        "php-open-source-saver/jwt-auth": "^2.3",
        "predis/predis": "^3.4",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "smalot/pdfparser": "*",
        "spatie/laravel-permission": "^6.25",
        "spatie/pdf-to-text": "*",
        "stripe/stripe-php": "^20.1",
        "thiagoalessio/tesseract_ocr": "*",
        "tymon/jwt-auth": "^2.3",
        "willvincent/laravel-rateable": "^3.5"
    },
    "require-dev": {
        "brianium/paratest": "^7.4.6 <7.9",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
 "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Modules\\Pharmacist\\": "Modules/Pharmacist/app/",
            "Modules\\MedicalFacility\\": "Modules/MedicalFacility/app/",
            "Modules\\Drug\\": "Modules/Drug/app/",
            "Modules\\AmbulanceCenter\\": "Modules/AmbulanceCenter/app/",
            "Modules\\Ambulance\\": "Modules/Ambulance/app/",
            "Modules\\Ambulance\\Services\\": "Modules/Ambulance/Services/",
            "Modules\\Ambulance\\Providers\\": "Modules/Ambulance/Providers/",
            "Modules\\Governorates\\": "Modules/Governorates/app/",
            "Modules\\Model\\": "Modules/Model/app/",
            "Modules\\Notifications\\": "Modules/Notifications/app/",
            "Modules\\Order\\": "Modules/Order/app/",
            "Modules\\Payment\\": "Modules/Payment/app/",
            "Modules\\Payment\\Adapters\\": "Modules/Payment/Adapters/",
            "Modules\\Payment\\Contracts\\": "Modules/Payment/Contracts/",
            "Modules\\Payment\\Services\\": "Modules/Payment/Services/",
            "Modules\\Payment\\DTOs\\": "Modules/Payment/DTOs/",
            "Modules\\Payment\\Strategies\\": "Modules/Payment/Strategies/",
            "Modules\\Price\\": "Modules/Price/app/",
            "Modules\\Product\\": "Modules/Product/app/",
            "Modules\\Stripe\\": "Modules/Stripe/app/",
            "Modules\\Subscription\\": "Modules/Subscription/app/",
            "Modules\\Subscription\\Database\\Factories\\": "Modules/Subscription/database/factories/",
            "Modules\\Subscription\\Database\\Seeders\\": "Modules/Subscription/database/seeders/",
            "Modules\\Wallet\\": "Modules/Wallet/app/",
            "Modules\\WalletTransaction\\": "Modules/WalletTransaction/app/",
            "Modules\\Disputes\\": "Modules/Disputes/app/",
            "Modules\\Disputes\\Database\\Seeders\\": "Modules/Disputes/database/seeders/",
            "Modules\\Consultation\\": "Modules/Consultation/app/",
            "Modules\\MedicalRecords\\": "Modules/MedicalRecords/app/",
            "Modules\\MedicalRecords\\Providers\\": "Modules/MedicalRecords/Providers/",
            "Modules\\MedicalRecords\\Jobs\\": "Modules/MedicalRecords/Jobs/",
            "Modules\\MedicalRecords\\Models\\": "Modules/MedicalRecords/Models/",
            "Modules\\MedicalRecords\\Services\\": "Modules/MedicalRecords/Services/",
            "Modules\\MedicalRecords\\Database\\Seeders\\": "Modules/MedicalRecords/database/seeders/",
            "Modules\\Laboratory\\": "Modules/Laboratory/app/",
            "Modules\\Laboratory\\Observers\\": "Modules/Laboratory/Observers/",
            "Modules\\Laboratory\\Services\\": "Modules/Laboratory/Services/",
            "Modules\\Laboratory\\Database\\Seeders\\": "Modules/Laboratory/database/seeders/",
            "Modules\\Pharmacy\\": "Modules/Pharmacy/",
            "Modules\\Admin\\": "Modules/Admin/",
            "Modules\\HomeCare\\Database\\Seeders\\": "Modules/HomeCare/database/seeders/",
            "Modules\\HomeCare\\Models\\": "Modules/HomeCare/Models/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test:db": [
            "@php scripts/setup-test-database.php"
        ],
        "test": [
            "@php scripts/check-test-requirements.php",
            "@php scripts/setup-test-database.php",
            "@php artisan config:clear --ansi",
            "@php artisan test --ansi"
        ],
        "test:ci": [
            "@php scripts/check-test-requirements.php",
            "@php scripts/setup-test-database.php",
            "@php artisan test --ansi"
        ],
        "test:setup": [
            "@php scripts/check-test-requirements.php",
            "@php scripts/setup-test-database.php",
            "@php artisan config:clear --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-extra": false
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hostinger: copy uploads to a real public folder when symlink() is disabled.
# Example: /home/u498370942/domains/example.com/public_html/storage
# PUBLIC_STORAGE_PATH=
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_management_system_2
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=xtyL9DB2MAvVCEbbLOci7H2eA2FxuA4ZNctQ2JKONLGZZXtzn99uu91h7MQzW2U3
# Access token lifetime in minutes (15 = re-login after quarter hour)
JWT_TTL=15
JWT_REFRESH_TTL=43200
# FIREBASE_CREDENTIALS relative to storage/ (Admin SDK private key JSON)
FIREBASE_CREDENTIALS=app/firebase/clinicmanagementsystem-6a7f2-firebase-adminsdk-fbsvc-522de7e4e3.json

# SOS patient notify timing (minutes). Requires: php artisan schedule:work
AMBULANCE_ESCALATE_MINUTES=1
AMBULANCE_EXPIRE_PENDING_MINUTES=5
AMBULANCE_OFFER_TTL_MINUTES=2
AMBULANCE_EXPIRE_ASSIGNED_HOURS=6
QUEUE_CONNECTION=redis

# Groq Medical AI Chat (Hostinger-ready — cloud API, no local LLM)
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Failover chain — first available model wins (comma-separated)
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b
# Legacy single model (used only when GROQ_MODELS is empty)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Medical AI chat — production: Groq with model + provider failover.
MEDICAL_AI_PROVIDERS=groq,gemini,openai

# Emergency triage — same cloud keys; Ollama only for local dev (OLLAMA_ENABLED=true).
EMERGENCY_AI_PROVIDER=groq
EMERGENCY_AI_FAILOVER=gemini,openai
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=90
EMERGENCY_AI_TWO_STAGE=true
# false = AI-first (professional). true = keyword rules can skip LLM (legacy/tests).
EMERGENCY_RULES_FIRST=false
EMERGENCY_RULES_OVERRIDE_SCORE=85
EMERGENCY_RULES_HINT_SCORE=60
EMERGENCY_CATEGORY_CONFLICT_SCORE=70
EMERGENCY_AI_EMBEDDINGS=true
EMERGENCY_EMBEDDING_MODEL=text-embedding-004
EMERGENCY_EMBEDDING_MIN_SCORE=0.35
EMERGENCY_EMBEDDING_CACHE_TTL=86400
EMERGENCY_AI_ANALYTICS=true

# Health checks (no auth):
#   GET /api/v1/ai/health
#   GET /api/v1/emergency/ai-health
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Smoke test (after queue worker + Gemini key on server):
#   curl -X POST "$APP_URL/api/v1/emergency/triage" -H "Content-Type: application/json" \
#     -d "{\"latitude\":33.5,\"longitude\":36.3,\"text_transcript\":\"ألم شديد في الصدر وضيق تنفس\"}"

# HttpOnly JWT cookie for web dashboards (React). Flutter keeps Bearer header.
JWT_HTTPONLY_COOKIE=true
JWT_COOKIE_NAME=acms_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_DOMAIN=
JWT_COOKIE_MINUTES=10080

# CORS for credentialed cookie auth (comma-separated origins; never use *)
CORS_SUPPORTS_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wallet demo mode: credit top-ups instantly without Stripe (local/testing only).
WALLET_INSTANT_TOPUP=false
# Ambulance SOS lifecycle
AMBULANCE_ESCALATE_MINUTES=2
AMBULANCE_EXPIRE_PENDING_MINUTES=5
AMBULANCE_EXPIRE_ASSIGNED_HOURS=6
AMBULANCE_OFFER_TTL_MINUTES=2

